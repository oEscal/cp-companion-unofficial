    <string name="exact_alarm_allowed">Exact alarms are allowed. Automatic tracking can start at the intended T-60 time.</string>
    <string name="exact_alarm_degraded">Exact alarms are not allowed. The app will use an inexact alarm and WorkManager recovery, which can be delayed.</string>
    <string name="notification_permission_allowed">Notification permission is available.</string>
    <string name="notification_permission_missing">Notification permission or the tracking channel is disabled.</string>
    <string name="automatic_cp_access_body">The app discovers the current public CP runtime configuration automatically. No private API key is stored.</string>
    <string name="automatic_inbox_import_body">Periodically check the SMS inbox for new CP ticket messages. This remains off until explicitly enabled.</string>
    <string name="detect_cp_sms_notifications_body">Use notification access to detect new CP ticket messages without periodically scanning the inbox.</string>
    <string name="diagnostics_body">Request counts are aggregated by endpoint family and do not contain passenger or ticket data.</string>
    <string name="inbox_disclosure_detailed">The first check reads a bounded recent window. Later checks use a received-time and message-ID cursor. Only CP-ticket candidates are retained and parsed locally; SMS content is not uploaded.</string>
    <string name="appearance_body">Choose whether CP Companion follows the device appearance or always uses a light or dark palette.</string>
    <string name="exact_alarm_access_available">Exact alarm access is available. Valid future tickets are scheduled to activate one hour before departure.</string>
    <string name="exact_alarm_access_unavailable">Exact alarm access is unavailable. The app uses an inexact alarm and WorkManager recovery, so activation may be delayed by system power management.</string>
    <string name="notification_tracking_requirement">Automatic sessions require an ongoing notification. If permission or the tracking channel is blocked, affected tickets remain in a recoverable blocked state.</string>
    <string name="automatic_cp_access_detailed">CP Companion discovers the current public CP service configuration automatically, validates CP-owned hosts, caches catalogues, and coordinates duplicate requests across the UI and tracking service.</string>
    <string name="automatic_inbox_import_detailed">When enabled, the app checks incrementally for new CP ticket messages. Disabling this switch cancels periodic inbox work.</string>
    <string name="notification_detection_enabled">Enabled. Strong CP ticket markers are parsed locally and duplicate notification content is ignored.</string>
    <string name="notification_detection_optional">Optional. Notification access can import new CP ticket messages without inbox permission.</string>
    <string name="manage_access">Manage access</string>
    <string name="enable_detection">Enable detection</string>
    <string name="live_tracking_behavior">Live tracking behavior</string>
    <string name="live_tracking_behavior_body">A standard silent ongoing notification starts at T-60. Live Update promotion is requested only when departure is imminent or the journey is active. Polling adapts between roughly 10 and 60 seconds and backs off globally after rate limiting.</string>
    <string name="no_request_counters">No request counters loaded.</string>
    <string name="notification_access_disclosure">Android notification access can expose notifications from all apps. CP Companion filters message-like notifications, processes strong CP-ticket markers locally, does not upload notification content, and lets you revoke access at any time.</string>
